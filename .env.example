# Spider — environment variables
# Copy to ".env" and fill in. Load locally with:  node --env-file=.env server/index.js
# (or set these in your host's dashboard). NEVER commit the real .env.

# --- Web login (required for the site to be usable) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must EXACTLY match a redirect added in the Discord app's OAuth2 settings.
# Local:       http://localhost:3000/auth/callback
# Production:  https://YOUR-DOMAIN/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Discord bot (only needed for `npm run bot`) ---
DISCORD_BOT_TOKEN=
ADMIN_IDS=
# Where the site is publicly reachable (used by the bot's login button).
PUBLIC_URL=http://localhost:3000
# Optional: register slash commands to ONE server for instant availability
# (global commands can take ~1h to appear the first time). Set to your server id.
DISCORD_GUILD_ID=
# Optional: only needed if the bot lives in a DIFFERENT Discord app than login.
# Leave blank — the bot derives its app id from DISCORD_BOT_TOKEN automatically.
DISCORD_BOT_CLIENT_ID=
# Set RUN_BOT=false to NOT run the bot inside the web server (e.g. if you run it
# as its own process). Default: the web server also runs the bot in-process.
# RUN_BOT=false

# --- AI gateway (required) ---
QWEN_API_KEY=
QWEN_BASE_URL=https://qwen38-api-production.up.railway.app
# AI_MAX_TOKENS=16000
# AI_MAX_CONTINUATIONS=6

# --- Persistent credits (recommended for hosting) ---
# Without these, credits live in data/users.json — which is WIPED on every
# redeploy on free hosts (Render/Railway). Set these to a free Upstash Redis
# database and credits persist forever. Create one at https://upstash.com
# (Redis -> Create Database), then copy the "REST API" URL + token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "production" on your host so cookies are marked Secure.
NODE_ENV=production

# --- Role mapping (Discord guild roles to Spider permissions) ---
# Role name that grants TESTER (unlimited credits).
# DISCORD_TESTER_ROLE=tester
# Role name that grants ADMIN (API key management, changelog posts, credit admin).
# DISCORD_ADMIN_ROLE=admin
# Discord channel id where bot changelog embeds land.
# CHANGELOG_CHANNEL_ID=

# --- Additional OAuth scopes for role resolution ---
# Defaults to "identify guilds.members.read" so the server can look up Discord
# roles immediately on login (no bot involvement needed at login-time).
# DISCORD_OAUTH_SCOPE=identify guilds.members.read
